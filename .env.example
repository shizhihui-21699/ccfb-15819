# HMAC secret for signed proxy/redirect capabilities. Required in production.
# Generate with: openssl rand -base64 48
PRIVACY_MAIL_PROXY_SECRET=change-me-with-openssl-rand-base64-48

# Bind address/port. Use 0.0.0.0 inside a container.
BIND_IP=127.0.0.1
PORT=4000

# Public origin + path prefix used in rewritten email URLs.
# Example: https://mail.example.com/privacy
PROXY_BASE_URL=
